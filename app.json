{
  "expo": {
    "name": "FlowerApp",
    "slug": "flower-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.donchan123.flowerapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends.",
          "cameraPermission": "The app accesses your camera to let you take photos of flowers."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5fcd8f1f-060a-4618-bb06-59ea68d5aa29"
      }
    }
  }
}
